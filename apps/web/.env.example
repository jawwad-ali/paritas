# Base URL of the Paritas API (no trailing slash), called straight from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Alternative (used on Vercel): leave NEXT_PUBLIC_API_URL empty and set this instead.
# This server then forwards /api/v1/* to the API, keeping the session cookie first-party.
API_PROXY_URL=

# Local demos only: show the seeded demo accounts on the sign-in page.
# Must equal SEED_DEMO_PASSWORD in apps/api/.env. Leave empty in any real deployment.
NEXT_PUBLIC_DEMO_PASSWORD=
