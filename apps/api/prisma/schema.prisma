// Paritas data model.
// Conventions:
//   - UUIDv7 primary keys (time-ordered → good B-tree locality).
//   - snake_case tables/columns in PostgreSQL, camelCase in TypeScript.
//   - Money is stored as integer minor units (cents) in BIGINT. Never floats.
//   - All timestamps are timestamptz with millisecond precision.
// Constraints Prisma cannot express (CHECKs, append-only audit trigger) live
// in the SQL migrations; see prisma/migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN // manages users, sources and matching configuration
  MANAGER // monitors reconciliation health; can work exceptions
  OFFICER // investigates and resolves exceptions

  @@map("user_role")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed.
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens         RefreshToken[]
  manualMatches         Match[]                   @relation("MatchCreatedBy")
  reversedMatches       Match[]                   @relation("MatchReversedBy")
  assignedExceptions    ReconciliationException[] @relation("ExceptionAssignee")
  resolvedExceptions    ReconciliationException[] @relation("ExceptionResolver")
  exceptionActivities   ExceptionActivity[]
  matchingConfigUpdates MatchingConfig[]

  @@index([role, isActive])
  @@map("users")
}

enum RefreshTokenRevokeReason {
  ROTATED // exchanged for a newer token (normal refresh)
  LOGOUT
  REUSE_DETECTED // a rotated token was presented again → whole family revoked
  PASSWORD_CHANGED
  USER_DEACTIVATED

  @@map("refresh_token_revoke_reason")
}

/// Opaque refresh tokens, stored only as SHA-256 hashes. Tokens issued from one
/// login share a `familyId`, so reuse of a rotated token revokes the session.
model RefreshToken {
  id            String                    @id @default(uuid(7)) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  familyId      String                    @map("family_id") @db.Uuid
  tokenHash     String                    @unique @map("token_hash")
  expiresAt     DateTime                  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz(3)
  revokedReason RefreshTokenRevokeReason? @map("revoked_reason")
  createdByIp   String?                   @map("created_by_ip")
  userAgent     String?                   @map("user_agent")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Ingestion
// ─────────────────────────────────────────────────────────────────────────────

enum SourceKind {
  PAYMENT_GATEWAY // e.g. Stripe: the provider's view of a payment
  INTERNAL_LEDGER // the company's own record of the same payment

  @@map("source_kind")
}

/// A system that reports transactions (a payment gateway or the internal ledger).
model Source {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// Stable machine identifier, e.g. "stripe", "internal_ledger".
  code      String     @unique
  name      String
  kind      SourceKind
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  rawEvents    RawEvent[]
  transactions Transaction[]

  @@map("sources")
}

enum RawEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED // valid event, but not one we reconcile (e.g. customer.updated)

  @@map("raw_event_status")
}

/// The untouched payload of every inbound event, kept for audit and replay.
/// (sourceId, externalEventId) is unique, which makes ingestion idempotent:
/// a webhook delivered twice is stored once.
model RawEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  sourceId        String         @map("source_id") @db.Uuid
  externalEventId String         @map("external_event_id")
  eventType       String         @map("event_type")
  payload         Json
  status          RawEventStatus @default(RECEIVED)
  error           String?
  receivedAt      DateTime       @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?      @map("processed_at") @db.Timestamptz(3)

  source       Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([sourceId, externalEventId])
  @@index([status, receivedAt])
  @@map("raw_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reconciliation
// ─────────────────────────────────────────────────────────────────────────────

/// Normalised payment lifecycle, independent of any provider's vocabulary.
enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@map("transaction_status")
}

enum ReconciliationStatus {
  UNMATCHED // not yet paired with its counterpart
  MATCHED // paired (auto or manual) and in agreement
  EXCEPTION // needs human attention; see linked exceptions

  @@map("reconciliation_status")
}

/// A transaction in the common, normalised format, regardless of source.
model Transaction {
  id                   String               @id @default(uuid(7)) @db.Uuid
  sourceId             String               @map("source_id") @db.Uuid
  /// Latest raw event that created or updated this row.
  rawEventId           String?              @map("raw_event_id") @db.Uuid
  /// Identifier inside the source system (Stripe PaymentIntent id, ledger row id…).
  externalId           String               @map("external_id")
  /// Cross-system reference used for exact matching (the gateway's payment id
  /// as recorded by both sides). Null when a source did not capture it.
  reference            String?
  /// Amount in minor units (cents). Always positive; direction lives in `status`.
  amountMinor          BigInt               @map("amount_minor")
  /// ISO 4217 code, upper-case.
  currency             String               @db.Char(3)
  status               TransactionStatus
  /// When the payment happened according to the source.
  occurredAt           DateTime             @map("occurred_at") @db.Timestamptz(3)
  /// Customer email or id, used as a fuzzy-matching signal.
  customerRef          String?              @map("customer_ref")
  description          String?
  metadata             Json                 @default("{}")
  reconciliationStatus ReconciliationStatus @default(UNMATCHED) @map("reconciliation_status")
  matchId              String?              @map("match_id") @db.Uuid
  /// Source timestamp of the newest event applied to this row. Events older than
  /// this are ignored, so out-of-order webhook delivery cannot roll state back.
  lastEventAt          DateTime             @map("last_event_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  source     Source                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  rawEvent   RawEvent?              @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  match      Match?                 @relation(fields: [matchId], references: [id], onDelete: SetNull)
  exceptions ExceptionTransaction[]

  @@unique([sourceId, externalId])
  @@index([reference])
  @@index([reconciliationStatus, occurredAt])
  @@index([sourceId, occurredAt])
  @@index([currency, amountMinor, occurredAt])
  @@index([matchId])
  @@map("transactions")
}

enum MatchMethod {
  EXACT // shared reference id
  FUZZY // amount + time + currency + customer signals above threshold
  MANUAL // linked by a user

  @@map("match_method")
}

enum MatchStatus {
  ACTIVE
  REVERSED // undone by a user; transactions return to the queue

  @@map("match_status")
}

/// Links transactions from different sources that represent the same payment.
model Match {
  id             String      @id @default(uuid(7)) @db.Uuid
  method         MatchMethod
  status         MatchStatus @default(ACTIVE)
  /// 0..1. Exact matches score 1.
  confidence     Float
  /// Per-signal scores, so every decision can be explained.
  scoreBreakdown Json?       @map("score_breakdown")
  note           String?
  createdById    String?     @map("created_by_id") @db.Uuid
  reversedById   String?     @map("reversed_by_id") @db.Uuid
  reversedAt     DateTime?   @map("reversed_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy    User?         @relation("MatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy   User?         @relation("MatchReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([method, createdAt])
  @@map("matches")
}

enum ExceptionType {
  MISSING // exists on one side only after the grace period
  AMOUNT_MISMATCH // counterpart found but amounts differ beyond tolerance
  DUPLICATE // same reference recorded more than once
  STATUS_CONFLICT // e.g. succeeded on one side, failed on the other
  DELAYED // counterpart still pending past expected settlement
  LOW_CONFIDENCE_MATCH // probable counterpart, below the auto-match threshold
  OTHER

  @@map("exception_type")
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("exception_severity")
}

enum ExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  IGNORED

  @@map("exception_status")
}

/// A discrepancy that needs a human decision.
model ReconciliationException {
  id               String            @id @default(uuid(7)) @db.Uuid
  /// Human-friendly sequence, rendered as EX-1042.
  number           Int               @unique @default(autoincrement())
  type             ExceptionType
  severity         ExceptionSeverity
  status           ExceptionStatus   @default(OPEN)
  title            String
  /// Type-specific facts: expected vs actual amounts, candidate ids, scores.
  details          Json              @default("{}")
  /// Deterministic key for the underlying issue, so the engine never opens two
  /// exceptions for the same problem (it reopens the existing one instead).
  dedupeKey        String            @unique @map("dedupe_key")
  assigneeId       String?           @map("assignee_id") @db.Uuid
  resolvedById     String?           @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?         @map("resolved_at") @db.Timestamptz(3)
  resolutionReason String?           @map("resolution_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignee     User?                  @relation("ExceptionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  resolvedBy   User?                  @relation("ExceptionResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  transactions ExceptionTransaction[]
  activities   ExceptionActivity[]

  @@index([status, severity, createdAt])
  @@index([type, status])
  @@index([assigneeId, status])
  @@index([createdAt])
  @@map("exceptions")
}

model ExceptionTransaction {
  exceptionId   String @map("exception_id") @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid

  exception   ReconciliationException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  transaction Transaction             @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@id([exceptionId, transactionId])
  @@index([transactionId])
  @@map("exception_transactions")
}

enum ExceptionActivityType {
  CREATED
  STATUS_CHANGED
  SEVERITY_CHANGED
  ASSIGNED
  NOTE_ADDED
  MANUALLY_MATCHED
  REOPENED

  @@map("exception_activity_type")
}

/// The investigation timeline of one exception. `actorId` null = the engine.
model ExceptionActivity {
  id          String                @id @default(uuid(7)) @db.Uuid
  exceptionId String                @map("exception_id") @db.Uuid
  actorId     String?               @map("actor_id") @db.Uuid
  type        ExceptionActivityType
  message     String?
  data        Json?
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  exception ReconciliationException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  actor     User?                   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([exceptionId, createdAt])
  @@map("exception_activities")
}

/// Matching rules, editable at runtime. Exactly one row (id = 1, enforced by a CHECK).
model MatchingConfig {
  id                   Int      @id @default(1)
  /// Absolute amount tolerance in minor units (absorbs fixed fees).
  amountToleranceMinor Int      @map("amount_tolerance_minor")
  /// Relative amount tolerance in basis points (100 bps = 1%; absorbs % fees).
  amountToleranceBps   Int      @map("amount_tolerance_bps")
  /// Max distance between the two sides' timestamps for a fuzzy match.
  timeWindowMinutes    Int      @map("time_window_minutes")
  /// Fuzzy matches scoring at or above this (0..1) are auto-confirmed.
  autoMatchThreshold   Float    @map("auto_match_threshold")
  /// Fuzzy matches below this are not even proposed as candidates.
  candidateThreshold   Float    @map("candidate_threshold")
  /// A one-sided transaction older than this becomes a MISSING exception.
  missingAfterMinutes  Int      @map("missing_after_minutes")
  updatedById          String?  @map("updated_by_id") @db.Uuid
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("matching_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only record of every important action. A database trigger rejects
/// UPDATE and DELETE, so history cannot be rewritten, even by the app.
/// Deliberately has no foreign keys: audit history must outlive what it describes.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null when the system acted (e.g. the matching engine).
  actorId    String?  @map("actor_id") @db.Uuid
  /// Snapshot at the time of the action.
  actorEmail String?  @map("actor_email")
  /// Dotted verb, e.g. "auth.login", "user.update", "exception.resolve".
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  /// { before, after } for updates; the created entity for creates.
  changes    Json?
  /// Request context: requestId, ip, userAgent.
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
