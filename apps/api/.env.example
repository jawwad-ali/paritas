# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Infrastructure (matches docker-compose.yml defaults) ─
DATABASE_URL=postgresql://paritas:paritas@localhost:5433/paritas?schema=public
# Hosts with a connection pooler (Neon on Vercel) also set a direct URL for migrations:
# DATABASE_URL_UNPOOLED=
REDIS_URL=redis://localhost:6380

# ── Background jobs ───────────────────────────────────────
# queue: BullMQ workers on Redis (retries, scheduled sweeps). Needs REDIS_URL.
# inline: in the request itself, for serverless hosts (Vercel); sweeps run on traffic and cron.
JOB_RUNNER=queue
# Bearer secret for GET /api/v1/internal/cron/sweep (Vercel Cron sends it). Empty = route off.
CRON_SECRET=

# ── API docs ──────────────────────────────────────────────
SWAGGER_ENABLED=true

# ── Rate limiting (per client IP) ─────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
# Reverse proxies in front of the API (0 when exposed directly)
TRUST_PROXY_HOPS=0

# ── Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies need HTTPS; "false" only for local http://localhost
AUTH_COOKIE_SECURE=false
# lax | strict | none (none requires AUTH_COOKIE_SECURE=true)
AUTH_COOKIE_SAMESITE=lax

# ── Seed (local demo data only) ───────────────────────────
SEED_DEMO_PASSWORD=Paritas-Demo-2026

# ── Transaction sources ───────────────────────────────────
# Stripe webhook signing secret (whsec_…). With the Stripe CLI, `stripe listen` prints it.
# Leave empty to disable the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional, TEST MODE ONLY: lets the simulator create real test payments.
# Prefer a restricted key (rk_test_…) with write access to PaymentIntents only.
STRIPE_SECRET_KEY=
# HMAC secret the internal ledger uses to sign its webhooks (min 32 chars)
INTERNAL_LEDGER_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-chars

# ── Demo data simulator (never enable in production) ─────
SIMULATOR_ENABLED=true
